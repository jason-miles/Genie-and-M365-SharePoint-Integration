# Copy to terraform.tfvars (git-ignored) and fill in.
databricks_host = "https://<your-workspace-url>"
tenant_id       = "00000000-0000-0000-0000-000000000000"
env             = "dev"

# catalog_name   = "m365"
# engineer_group = "grp-rag-engineers"
# agent_principal = "<service-principal-application-id>"   # the identity that runs your agent / app
# secret_reader   = "<run-as-service-principal>"            # prod: only the job identity should read the client secret

# First apply: leave false. After the first parse job run, set true and apply again.
create_vector_index = false
